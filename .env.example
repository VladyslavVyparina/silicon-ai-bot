# ============================================================
# Silicon AI Bot — налаштування
# Заповніть значення після знаку = (без пробілів навколо =)
# ============================================================

# false = реальні API (production)
# true  = тестовий режим без ключів
MOCK_EXTERNAL_APIS=false
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:////root/ai_silicon/data/silicon_bot.db

# ---------- OpenAI (ChatGPT) ----------
# Взяти: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ---------- Telegram Bot ----------
# Взяти: @BotFather → /token (якщо токен світився в чаті — зробіть /revoke і новий)
TELEGRAM_BOT_TOKEN=

# ---------- SendPulse (якщо бот через SendPulse) ----------
# Взяти: SendPulse → Settings → API
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_BOT_ID=

# ---------- Onebox CRM ----------
# Взяти: Onebox → API / токен доступу
ONEBOX_API_URL=https://api.onebox.systems
ONEBOX_API_KEY=
ONEBOX_WEBHOOK_SECRET=

# ---------- LiqPay (оплата) ----------
# Взяти: https://www.liqpay.ua/ → магазин → ключі
# LIQPAY_SANDBOX=true для тестів, false для реальних платежів
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# ---------- Нова пошта (ТТН) ----------
# Взяти: кабінет Нової пошти → Налаштування → Безпека → API ключі
# REF-и відправника — з API або кабінету НП
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_CONTACT_SENDER_REF=
NOVA_POSHTA_CITY_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=

# ---------- Адмін-панель менеджера ----------
# Пароль і email власника (створюється при першому запуску)
ADMIN_PASSWORD=silicon-admin
ADMIN_OWNER_EMAIL=owner@silicon.local
# Секрет для підпису токена сесії (змініть у production)
ADMIN_SECRET_KEY=change-me-silicon-admin-secret
# URL адмін-панелі (сповіщення менеджерам, листи)
ADMIN_PUBLIC_URL=http://127.0.0.1:8000
# Публічний URL для /pay/... — можна IP (http://173.242.60.134:8000), домен не обовʼязковий.
# Якщо порожньо — береться ADMIN_PUBLIC_URL.
PUBLIC_BASE_URL=
# Telegram chat_id для сповіщень про нові заявки менеджеру (опційно)
ADMIN_NOTIFY_CHAT_ID=

# ---------- SMTP (листи з доступом менеджерам) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---------- 1С HTTP-сервіс bot-api ----------
# База публікації, наприклад:
#   http://localhost/silikon
#   http://185.161.208.178/FOPAfonin
# Бот сам додасть /hs/bot-api/v1
# (можна вказати повний шлях .../hs/bot-api/v1)
ONEC_API_URL=http://185.161.208.178/FOPAfonin
ONEC_API_USER=
ONEC_API_PASSWORD=

# ---------- Реквізити продавця для PDF-рахунку ----------
INVOICE_SELLER_NAME=ФОП Афонін Дмитро Вікторович
INVOICE_SELLER_ADDRESS=вулиця Київська, буд. 22, с. Бриків, Шумський район, Тернопільська обл., 47140
INVOICE_SELLER_PHONE=0958814263
INVOICE_SELLER_IPN=3052600213
INVOICE_SELLER_BANK=КБ "ПРИВАТБАНК" М.ДНІПРО
INVOICE_SELLER_IBAN=UA393052990000026006003304573

